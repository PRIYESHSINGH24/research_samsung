"""
TABLE 6 — CIFAR-10 (ResNet-18 Teacher)
Paper: lr=0.01, batch=512, 500 epochs → 86.54%
DI lr=0.001, β={1.0, 0.1}, τ=20
"""
import torch, torch.nn as nn, torch.nn.functional as F, torch.optim as optim
from torch.utils.data import DataLoader, Dataset
from torchvision import datasets, transforms
from tqdm import tqdm
import numpy as np, os
from models.resnet import ResNet18, ResNet18Half
from config import config

def get_cifar_loaders(bs=512):
    tr = transforms.Compose([transforms.ToTensor(), transforms.Normalize((0.4914,0.4822,0.4465),(0.2023,0.1994,0.2010))])
    train_data = datasets.CIFAR10('data/', train=True, download=False, transform=tr)
    test_data = datasets.CIFAR10('data/', train=False, download=False, transform=tr)
    return DataLoader(train_data, batch_size=bs, shuffle=True, num_workers=0, pin_memory=True), \
           DataLoader(test_data, batch_size=256, shuffle=False, num_workers=0, pin_memory=True)

def evaluate(model, loader):
    model.eval(); correct=total=0
    with torch.no_grad():
        for img, lab in loader:
            img, lab = img.to(config.DEVICE), lab.to(config.DEVICE)
            _, pred = model(img).max(1); total += lab.size(0); correct += pred.eq(lab).sum().item()
    return 100.*correct/total

def compute_sim(model):
    w = model.get_final_weights()
    s = F.cosine_similarity(w.unsqueeze(1), w.unsqueeze(0), dim=2)
    row_min = s.min(dim=1, keepdim=True).values
    row_max = s.max(dim=1, keepdim=True).values
    s = (s - row_min) / (row_max - row_min + 1e-8)
    return s.cpu().numpy()

_CIFAR_MEAN = torch.tensor([0.4914, 0.4822, 0.4465]).view(1, 3, 1, 1)
_CIFAR_STD  = torch.tensor([0.2023, 0.1994, 0.2010]).view(1, 3, 1, 1)
_CLAMP_MIN = ((0.0 - _CIFAR_MEAN) / _CIFAR_STD)
_CLAMP_MAX = ((1.0 - _CIFAR_MEAN) / _CIFAR_STD)

def gen_di(model, targets, dev):
    B = targets.shape[0]
    cmin, cmax = _CLAMP_MIN.to(dev), _CLAMP_MAX.to(dev)
    di = torch.randn(B, 3, 32, 32, device=dev)
    with torch.no_grad():
        di = torch.max(torch.min(di, cmax), cmin)
    di.requires_grad_(True)
    targets = targets.to(dev); opt = torch.optim.Adam([di], lr=0.1)
    for _ in range(400):
        opt.zero_grad(); logits = model(di, temperature=20); pred = F.softmax(logits, dim=1)
        loss = -torch.mean(torch.sum(targets * torch.log(pred + 1e-8), dim=1))
        loss.backward(); opt.step()
        with torch.no_grad(): di.data = torch.max(torch.min(di.data, cmax), cmin)
    return di.detach()

class AugDI(Dataset):
    def __init__(self, images, labels):
        self.images, self.labels = images, labels
        self.tf = transforms.Compose([transforms.ToPILImage(), transforms.RandomAffine(15, (0.1,0.1), (0.9,1.1)), transforms.RandomHorizontalFlip(), transforms.ToTensor()])
    def __len__(self): return len(self.images)
    def __getitem__(self, i):
        img, lab = self.images[i], self.labels[i]
        mn, mx = img.min(), img.max(); n = (img-mn)/(mx-mn+1e-8)
        a = self.tf(n); a = a*(mx-mn)+mn; return a, lab

if __name__ == "__main__":
    os.makedirs(config.CHECKPOINT_DIR, exist_ok=True)
    print("="*60); print("  TABLE 6 — ResNet-18 Teacher CIFAR-10"); print("="*60)

    # 1. Teacher (Paper: lr=0.01, batch=512, 500ep)
    print("\n  --- ResNet-18 Teacher ---")
    train_loader, test_loader = get_cifar_loaders(512)
    teacher = ResNet18().to(config.DEVICE)
    opt = optim.SGD(teacher.parameters(), lr=0.01, momentum=0.9, weight_decay=5e-4)
    sch = optim.lr_scheduler.MultiStepLR(opt, milestones=[250,375], gamma=0.1)
    best_t = 0
    
    if os.path.exists(f'{config.CHECKPOINT_DIR}resnet18_cifar_teacher.pth'):
        teacher.load_state_dict(torch.load(f'{config.CHECKPOINT_DIR}resnet18_cifar_teacher.pth', map_location=config.DEVICE))
        teacher.eval()
        best_t = evaluate(teacher, test_loader)
        print(f"  Loaded saved ResNet-18 Teacher model. Acc: {best_t:.2f}%")
        epochs_range = []
    else:
        epochs_range = range(1, 151)
        
    for ep in epochs_range:
        teacher.train()
        for img, lab in tqdm(train_loader, leave=False, desc=f"T{ep}"):
            img, lab = img.to(config.DEVICE), lab.to(config.DEVICE)
            opt.zero_grad(); nn.CrossEntropyLoss()(teacher(img), lab).backward(); opt.step()
        sch.step(); acc = evaluate(teacher, test_loader)
        if acc > best_t: best_t = acc; torch.save(teacher.state_dict(), f'{config.CHECKPOINT_DIR}resnet18_cifar_teacher.pth')
        if ep % 50 == 0 or ep == 1: print(f"  Ep {ep}: {acc:.2f}% | Best: {best_t:.2f}%")
    print(f"  Teacher: {best_t:.2f}% (Paper: 86.54%)")

    # 2. Student-CE
    print("\n  --- ResNet-18-Half CE ---")
    student = ResNet18Half().to(config.DEVICE)
    opt = optim.SGD(student.parameters(), lr=0.01, momentum=0.9, weight_decay=5e-4)
    sch = optim.lr_scheduler.MultiStepLR(opt, milestones=[250,375], gamma=0.1)
    best_ce = 0
    for ep in range(1, 151):
        student.train()
        for img, lab in tqdm(train_loader, leave=False, desc=f"CE{ep}"):
            img, lab = img.to(config.DEVICE), lab.to(config.DEVICE)
            opt.zero_grad(); nn.CrossEntropyLoss()(student(img), lab).backward(); opt.step()
        sch.step(); acc = evaluate(student, test_loader)
        if acc > best_ce: best_ce = acc
        if ep % 50 == 0 or ep == 1: print(f"  Ep {ep}: {acc:.2f}% | Best: {best_ce:.2f}%")
    print(f"  Half CE: {best_ce:.2f}% (Paper: 85.51%)")

    # 3. Student-KD
    print("\n  --- ResNet-18-Half KD ---")
    teacher = ResNet18().to(config.DEVICE)
    teacher.load_state_dict(torch.load(f'{config.CHECKPOINT_DIR}resnet18_cifar_teacher.pth', map_location=config.DEVICE)); teacher.eval()
    student = ResNet18Half().to(config.DEVICE)
    opt = optim.Adam(student.parameters(), lr=0.001)
    best_kd = 0
    for ep in range(1, 151):
        student.train()
        for img, _ in tqdm(train_loader, leave=False, desc=f"KD{ep}"):
            img = img.to(config.DEVICE)
            with torch.no_grad(): tl = teacher(img)
            sl = student(img)
            loss = F.kl_div(F.log_softmax(sl/20,1), F.softmax(tl/20,1), reduction='batchmean') * 400
            opt.zero_grad(); loss.backward(); opt.step()
        acc = evaluate(student, test_loader)
        if acc > best_kd: best_kd = acc
        if ep % 50 == 0 or ep == 1: print(f"  Ep {ep}: {acc:.2f}% | Best: {best_kd:.2f}%")
    print(f"  Half KD: {best_kd:.2f}% (Paper: 86.31%)")

    # 4. Generate DIs
    print("\n  --- Generate DIs (lr=0.001) ---")
    teacher.eval(); sim = compute_sim(teacher)
    all_dis, all_lab = [], []; N = 4000
    for c in range(10):
        cdis = []
        for beta in [1.0, 0.1]:
            n = N//2; a = sim[c]*beta; a = np.clip(a,1e-3,None)
            tgts = torch.tensor(np.random.dirichlet(a, n), dtype=torch.float32)
            for s in tqdm(range(0,n,500), desc=f"  C{c} β={beta}"):
                e = min(s+500, n); cdis.append(gen_di(teacher, tgts[s:e], config.DEVICE).cpu())
        ct = torch.cat(cdis, 0); all_dis.append(ct); all_lab.extend([c]*N)
        print(f"  ✅ C{c}: {ct.shape[0]}")
    all_dis = torch.cat(all_dis, 0); all_lab = torch.tensor(all_lab, dtype=torch.long)
    torch.save({'di_images': all_dis, 'di_labels': all_lab}, f'{config.CHECKPOINT_DIR}resnet18_cifar_dis.pth')

    # 5. ZSKD
    print("\n  --- ZSKD ---")
    _, test_loader = get_cifar_loaders(256)
    dl = DataLoader(AugDI(all_dis, all_lab), batch_size=256, shuffle=True, num_workers=0)
    student = ResNet18Half().to(config.DEVICE)
    opt = optim.Adam(student.parameters(), lr=0.001, weight_decay=1e-4)
    sch = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=150, eta_min=1e-6)
    best_z = 0
    for ep in range(1, 151):
        student.train()
        for b, _ in dl:
            b = b.to(config.DEVICE)
            with torch.no_grad(): tl = teacher(b)
            sl = student(b)
            loss = F.kl_div(F.log_softmax(sl/20,1), F.softmax(tl/20,1), reduction='batchmean') * 400
            opt.zero_grad(); loss.backward(); opt.step()
        sch.step(); acc = evaluate(student, test_loader)
        if acc > best_z: best_z = acc
        if ep % 50 == 0 or ep == 1: print(f"  Ep {ep}: {acc:.2f}% | Best: {best_z:.2f}%")

    print(f"\n{'='*60}")
    print(f"  TABLE 6 RESULTS")
    print(f"{'='*60}")
    print(f"  {'ResNet-18 (T)':<30s} {f'{best_t:.2f}%':>8s}  {'86.54%':>8s}")
    print(f"  {'ResNet-18-Half CE':<30s} {f'{best_ce:.2f}%':>8s}  {'85.51%':>8s}")
    print(f"  {'ResNet-18-Half KD':<30s} {f'{best_kd:.2f}%':>8s}  {'86.31%':>8s}")
    print(f"  {'ResNet-18-Half ZSKD':<30s} {f'{best_z:.2f}%':>8s}  {'81.10%':>8s}")
    print(f"{'='*60}")